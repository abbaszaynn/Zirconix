# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Both values below are SAFE to ship in a mobile bundle: the publishable/anon key
# only ever grants what Row Level Security allows. Every table in this project has
# RLS enabled, so this key alone cannot read or write another director's data.
EXPO_PUBLIC_SUPABASE_URL=https://vcoagdrbqsxshczvnwrp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the service_role key in this file or anywhere under EXPO_PUBLIC_*.
# It bypasses RLS. It belongs only in Supabase Edge Function secrets and in
# GitHub Actions repository secrets.
